# 复制为 .env 后填写；.env 已被仓库 .gitignore 忽略。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
MULTICA_BIN=
MULTICA_PROJECT_ID=
MULTICA_BOT_MEMORY_DB=
MULTICA_BOT_LLM_PROVIDER=mock
# 仅当 MULTICA_BOT_LLM_PROVIDER=openai 时填写；不会读取全局 OPENAI_* 环境变量。
MULTICA_BOT_LLM_API_KEY=
MULTICA_BOT_LLM_BASE_URL=
MULTICA_BOT_LLM_MODEL=
# 可选：建单成功后再 POST 一条 Markdown 到群
# DINGTALK_WEBHOOK_URL=
# 可选：设为 1 则跳过互动卡片，只用 session Markdown（不申请 Card.Instance.Write 时用）
# DISPATCH_SKIP_MARKDOWN_CARD=1
# 可选：网页工单路径中的 workspace 段，用于「点击查看」直达链接，例：uu-myagents
# MULTICA_WORKSPACE_WEB_PATH=uu-myagents

# 可选：自动开发 Agent 的隔离工作区根目录；每个工单会创建 .worktrees/{issue_id}
# DEV_AGENT_WORKTREE_ROOT=D:\MyAgents\.worktrees

# 可选：工单进入 In Review 后自动调用独立 ClaudeAgent reviewer 做只读代码审查
# CODE_REVIEW_ENABLED=0
# CODE_REVIEW_COMMAND=claude
# CODE_REVIEW_MULTICA_BIN=multica
# CODE_REVIEW_ARGS=--print --output-format json
# CODE_REVIEW_REPO_ROOT=D:\MyAgents
# CODE_REVIEW_TIMEOUT=1800
# CODE_REVIEW_SEND_TIMEOUT=90
# CODE_REVIEW_DAEMON_CID=
# DINGTALK_DAEMON_URL=http://127.0.0.1:19200

# 可选：进入 In Review 后走哪种审查（status_watcher 轮询触发）。cli=仅 Claude CLI；hermes=仅 Hermes run_agent（当当 skill）；both=两套都跑（一般勿开，可能重复报告）
# IN_REVIEW_REVIEW_BACKEND=cli

# 可选：审查兜底通知（与 webhook_config.json 键「当当」二选一即可）。配置后，CLI/Hermes 审查失败会向该 webhook 发 Markdown，便于 Hermes 挂了仍通知老大介入。
# MULTICA_REVIEW_ESCALATION_WEBHOOK_URL=

# 主 webhook（DEV_AGENT_NOTIFY_WEBHOOK / cursor_session）投递范围。默认 review_and_failures：只发「审查完毕」+「运行/工单失败」+「自动合并冲突」等；不发 Claude 工作中/完成、待审查、Agent 启动与进度等（防 AgentWork 刷屏）。恢复全量通知：all
# MULTICA_WEBHOOK_NOTIFY_SCOPE=review_and_failures

# 可选：自动合并 agent/{工单号} → main 的 Multica 状态触发器。默认 approved（若工作区无该状态则永远不会合并）；界面只有 Done 时可设为 done
# MULTICA_AUTO_MERGE_TRIGGER_STATUS=approved

# 可选：Hermes 路径审查（与 CODE_REVIEW_* 二选一时常用 hermes + 下方开关）。需本机 Hermes 及 run_agent.py 可用。
# HERMES_REVIEW_ENABLED=1
# HERMES_HOME=D:\hermes
# HERMES_REVIEW_AGENT_ROOT=
# HERMES_REVIEW_PYTHON=py
# HERMES_REVIEW_MAX_TURNS=40
# HERMES_REVIEW_TIMEOUT=1800
# HERMES_REVIEW_DAEMON_CID=
# HERMES_REVIEW_DINGTALK_TARGET=

# 可选：Multica 平台 daemon 隔离执行配置。workspaces root 必须在仓库外，避免普通 workdir 向上命中 D:\MyAgents\.git。
# MULTICA_REPOS_ROOT=D:\MyAgents
# MULTICA_WORKSPACES_ROOT=C:\Users\TU\multica_workspaces
# MULTICA_DAEMON_MAX_CONCURRENT_TASKS=2
# MULTICA_KEEP_ENV_AFTER_TASK=1

# 可选：派单桥 project 自动归类；默认读取同目录 multica_project_map.json。
# MULTICA_PROJECT_MAP_FILE=D:\MyAgents\tools\multica-dingtalk-bridge\multica_project_map.json
