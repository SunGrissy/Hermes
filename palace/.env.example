# Palace Engine Configuration
# Provider: "mock" (dev/test) or "openai_compatible" (Phase 5+)
# mock 时场景 interview_checklist 仅输出占位内容，真实生成需 openai_compatible
PALACE_PROVIDER=mock

# LLM API settings (only needed when PALACE_PROVIDER=openai_compatible)
PALACE_API_KEY=
PALACE_API_BASE=https://open.bigmodel.cn/api/paas/v4
PALACE_MODEL=glm-4

# Override PLAYBOOK path (default: ../PLAYBOOK.md relative to palace/)
# PALACE_PLAYBOOK_PATH=
