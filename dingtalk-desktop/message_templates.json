{
  "_comment": "所有消息推送模板统一维护于此文件。改此文件即可调整文案/格式/显隐，无需改 Python 代码。",

  "version_digest": {
    "title": "## 版本状态 [{timestamp}]",

    "version": {
      "header": "### **{name}** | {phase}",

      "countdown": {
      "overdue":  "❗**[超期]** 已到/超过发版日",
      "urgent":   "⚠️**[紧]** {days}天后发版",
      "normal":   "✅ {days}天后发版",
        "urgent_threshold_days": 7
      },

      "feature_line":   "**Feature**: {summary}",
      "capacity_line":  "**容量**: {pct}%",
      "milestone_line": "**里程碑**: {ms_name} ({ms_date})",
      "pipeline_line":  "**管线节点**: {node_name} ({node_date})",
      "overdue_line":   "⛔**[超期节点]** {nodes}",
      "risk_line":      "⚠️**[风险]** {text}"
    },

    "show": {
      "capacity":         true,
      "milestone":        true,
      "pipeline_current": true,
      "overdue_nodes":    true,
      "risks":            true
    },

    "limits": {
      "risks": 3
    },

    "separator": "---",
    "footer":    "###### ※ 小秘书提醒"
  },

  "report_digest": {
    "title": "### {date} 日报摘要 {window}",

    "submission": {
      "submitted_line": "✅ 已提交 {count}/{total} 人",
      "missing_line":   "❌ 未交：{names}",
      "missing_sep":    " / "
    },

    "sections": {
      "summary": {
        "header": "【总览】",
        "show": true
      },
      "tech_updates": {
        "header": "【技术动态】",
        "item_format": "· {name}：{doing}",
        "show": true
      },
      "quality_flags": {
        "header": "⚠️ 质量标记",
        "item_format": "• {name}：{issue}",
        "show": true,
        "max_items": 8
      },
      "attention_items": {
        "header": "【关注】",
        "item_format": "→ [{source}] {content}",
        "show": true,
        "max_items": 8
      }
    },

    "llm": {
      "_note": "每人日报发给 LLM 的最大字符数，写长日报的人（如崔正钦）建议 2500+",
      "text_limit_per_person": 2500
    }
  },

  "memo_tracker": {
    "confirm": "memo #{seq}: {summary}",
    "close": "✅ done: memo #{seq} {summary}",
    "delete": "❌ 备忘 #{seq} 已删除：{summary}",
    "already_deleted": "⚠️ 备忘 #{seq} 已是删除状态",
    "not_found": "❓ not found: memo #{seq}",
    "today_focus_title": "**今日关注**（到期 / 超期）",
    "today_focus_empty": "今天没有到期或超期的备忘。",
    "today_focus_item": "#{seq} {text}（{due}）",
    "reminder_title": "### memo follow-up: {count} pending",
    "reminder_urgent": "**⚠️ urgent({count}):**",
    "reminder_due_soon": "**⏰ due this week({count}):**",
    "reminder_other": "**other({count}):**",
    "reminder_item": "  #{seq} {who} {text} ({due_info})",
    "footer": "###### bot reminder"
  },

  "resume_screen": {
    "title": {
      "pass":    "✅ 简历初筛通过 | {candidate} · {role}",
      "pending": "❓ 简历初筛待定 | {candidate} · {role}",
      "fail":    "❌ 简历初筛不通过 | {candidate} · {role}"
    },

    "title_fresh": {
      "pass":    "✅ 应届初筛通过 | {candidate} · {role}",
      "pending": "❓ 应届初筛待定 | {candidate} · {role}",
      "fail":    "❌ 应届初筛不通过 | {candidate} · {role}"
    },

    "lines": [
      { "key": "core",       "show": true, "tpl": "❗ **核心判定：** {core}" },
      { "key": "highlights", "show": true, "tpl": "✅ **亮点：** {highlights}" },
      { "key": "redlines",   "show": true, "tpl": "❌ **红线：** {redlines}" },
      { "key": "reason",     "show": true, "tpl": "▶ **理由：** {reason}" }
    ],

    "fresh_lines": [
      { "key": "core",      "show": true, "tpl": "❗ **核心判定：** {core}" },
      { "key": "potential", "show": true, "tpl": "✅ **潜力信号：** {potential}" },
      { "key": "redlines",  "show": true, "tpl": "❌ **红线：** {redlines}" },
      { "key": "reason",    "show": true, "tpl": "▶ **理由：** {reason}" }
    ],

    "source_line": "► **来源：** {source}",

    "footer": "###### ※ 小秘书提醒"
  },

  "status_check": {
    "_note": "MyAgents 工具运行状态检查，由「上班啦」触发，通过机器人 webhook 发送（关键词：小秘书提醒）",
    "keyword": "小秘书提醒",
    "title": "## 工具状态 [{timestamp}]",
    "intro": "收到「上班啦」，已执行一次检查：",
    "item_ok": "✅ **{name}** — 正常（{endpoint}）",
    "item_fail": "❌ **{name}** — 未响应（{endpoint}）",
    "item_skip": "⏭ **{name}** — 未检测（{reason}）",
    "summary_ok": "**汇总**：{ok_count}/{total} 项正常",
    "summary_partial": "**汇总**：{ok_count}/{total} 项正常，{fail_count} 项异常",
    "separator": "---",
    "footer": "###### ※ 小秘书提醒"
  },

  "doc_review": {
    "_note": "预审流程各阶段推送文案，均需含「小秘书提醒」以触发机器人",
    "keyword": "小秘书提醒",
    "started": "小秘书提醒 收到文档链接，正在读取并预审，请稍候（约 1-2 分钟）...",
    "fetch_fail": "小秘书提醒 文档读取失败: {error}",
    "content_too_short": "小秘书提醒 文档《{title}》内容过少（{length} 字），可能页面未完全渲染。\n{url}",
    "palace_fail": "小秘书提醒 文档预审引擎异常: {error}\n文档: {title}\n{url}",
    "no_link": "小秘书提醒 收到预审指令，但未找到最近的文档链接。请先发送文档链接，再发送「预审」。",
    "recently_attempted": "小秘书提醒 该文档在近期已尝试过预审，请 {minutes} 分钟后再试。",
    "summary_header": "小秘书提醒 文档预审完成",
    "summary_doc": "文档: {title}",
    "summary_verdict": "结论: {verdict_emoji} {verdict_label}",
    "summary_p0": "P0 阻断: {count} 项",
    "summary_p1": "P1 关注: {count} 项",
    "summary_chars": "提取字数: {text_length}",
    "summary_report": "完整报告: {report_url}",
    "summary_original": "原文: {url}",
    "footer": "###### ※ 小秘书提醒"
  }
}
