{
  "_comment": "所有消息推送模板统一维护于此文件。改此文件即可调整文案/格式/显隐，无需改 Python 代码。",

  "version_digest": {
    "title": "## 版本状态 [{timestamp}]",

    "version": {
      "header": "### **{name}** | {phase}",

      "countdown": {
      "overdue":  "❗**[超期]** 已到/超过发版日",
      "urgent":   "⚠️**[紧]** {days}天后发版",
      "normal":   "✅ {days}天后发版",
        "urgent_threshold_days": 7
      },

      "feature_line":   "**Feature**: {summary}",
      "capacity_line":  "**容量**: {pct}%",
      "milestone_line": "**里程碑**: {ms_name} ({ms_date})",
      "pipeline_line":  "**管线节点**: {node_name} ({node_date})",
      "overdue_line":   "⛔**[超期节点]** {nodes}",
      "risk_line":      "⚠️**[风险]** {text}"
    },

    "show": {
      "capacity":         true,
      "milestone":        true,
      "pipeline_current": true,
      "overdue_nodes":    true,
      "risks":            true
    },

    "limits": {
      "risks": 3
    },

    "separator": "---",
    "footer":    "###### ※ 小秘书提醒"
  },

  "report_digest": {
    "title": "### {date} 日报摘要 {window}",

    "submission": {
      "submitted_line": "✅ 已提交 {count}/{total} 人",
      "missing_line":   "❌ 未交：{names}",
      "missing_sep":    " / "
    },

    "sections": {
      "summary": {
        "header": "【总览】",
        "show": true
      },
      "tech_updates": {
        "header": "【技术动态】",
        "item_format": "· {name}：{doing}",
        "show": true
      },
      "quality_flags": {
        "header": "⚠️ 质量标记",
        "item_format": "• {name}：{issue}",
        "show": true,
        "max_items": 8
      },
      "attention_items": {
        "header": "【关注】",
        "item_format": "→ [{source}] {content}",
        "show": true,
        "max_items": 8
      }
    },

    "llm": {
      "_note": "每人日报发给 LLM 的最大字符数，写长日报的人（如崔正钦）建议 2500+",
      "text_limit_per_person": 2500
    }
  },

  "memo_tracker": {
    "_note": "TaskReminder 任务到期/待关注自动推送，通过 memo_tracker webhook 发送，正文须含关键词「小秘书提醒」",
    "keyword": "小秘书提醒",
    "webhook_keyword": "小秘书提醒",
    "confirm": "#### 备忘已收录\n\nMemo #{seq}\n{summary}\n\n----",
    "close": "✅ done: memo #{seq} {summary}",
    "delete": "❌ 备忘 #{seq} 已删除：{summary}",
    "already_deleted": "⚠️ 备忘 #{seq} 已是删除状态",
    "not_found": "❓ not found: memo #{seq}",
    "today_focus_title": "### **今日关注** {date}（到期 / 超期）",
    "today_focus_empty": "今天没有到期或超期的备忘。",
    "today_focus_item": "**#{seq}** {text}{overdue_suffix}",
    "tomorrow_focus_title": "### **明日关注** {date}",
    "tomorrow_focus_empty": "明天没有到期的备忘。",
    "week_focus_title": "### **本周关注** {date}～{end_date}",
    "week_focus_empty": "本周没有到期或超期的备忘。",
    "wish_confirm": "#### 愿望已收录\n\nWish #{seq}\n{summary}\n\n----",
    "wish_list_title": "### **愿望单** 未完成任务",
    "wish_list_empty": "当前没有分配给「{assignee}」的未完成任务。",
    "wish_list_item": "**wish #{seq}** {title}",
    "wish_list_item_legacy": "· {title}（旧版，仅 TR）",
    "wish_delete": "wish #{seq} 已删除：{summary}",
    "wish_already_deleted": "wish #{seq} 已是删除状态",
    "wish_not_found": "not found: wish #{seq}",
    "wish_close": "done: wish #{seq} {summary}",
    "wish_close_already": "wish #{seq} 已是完成状态",
    "wish_close_deleted": "wish #{seq} 已删除，无法完成",
    "task_due_digest_title": "## 任务到期与待关注 [{date}]",
    "reminder_subtitle": "**待跟进 {count} 项**",
    "section_urgent": "### ⚠️ 紧急 / 超期（{count}）",
    "section_due_soon": "### 本周到期（{count}）",
    "section_other": "### 其他（{count}）",
    "item_line": "> **#{seq}** {who} {text}",
    "item_due_tag": "> {due_info}",
    "due_overdue": "已超期 {days} 天",
    "due_today": "今日到期",
    "due_normal": "还剩 {days} 天",
    "separator": "---",
    "footer": "###### ※ 小秘书提醒"
  },

  "resume_screen": {
    "title": {
      "pass":    "✅ 简历初筛通过 | {candidate} · {role}",
      "pending": "❓ 简历初筛待定 | {candidate} · {role}",
      "fail":    "❌ 简历初筛不通过 | {candidate} · {role}"
    },

    "title_fresh": {
      "pass":    "✅ 应届初筛通过 | {candidate} · {role}",
      "pending": "❓ 应届初筛待定 | {candidate} · {role}",
      "fail":    "❌ 应届初筛不通过 | {candidate} · {role}"
    },

    "lines": [
      { "key": "core",       "show": true, "tpl": "❗ **核心判定：** {core}" },
      { "key": "highlights", "show": true, "tpl": "✅ **亮点：** {highlights}" },
      { "key": "redlines",   "show": true, "tpl": "❌ **红线：** {redlines}" },
      { "key": "reason",     "show": true, "tpl": "▶ **理由：** {reason}" }
    ],

    "fresh_lines": [
      { "key": "core",      "show": true, "tpl": "❗ **核心判定：** {core}" },
      { "key": "potential", "show": true, "tpl": "✅ **潜力信号：** {potential}" },
      { "key": "redlines",  "show": true, "tpl": "❌ **红线：** {redlines}" },
      { "key": "reason",    "show": true, "tpl": "▶ **理由：** {reason}" }
    ],

    "source_line": "► **来源：** {source}",

    "footer": "###### ※ 小秘书提醒"
  },

  "status_check": {
    "_note": "MyAgents 工具运行状态检查，由「上班啦」触发，通过机器人 webhook 发送（关键词：小秘书提醒）",
    "keyword": "小秘书提醒",
    "title": "## 工具状态 [{timestamp}]",
    "intro": "收到「上班啦」，已执行一次检查：",
    "item_ok": "✅ **{name}** — 正常（{endpoint}）",
    "item_fail": "❌ **{name}** — 未响应（{endpoint}）",
    "item_skip": "⏭ **{name}** — 未检测（{reason}）",
    "summary_ok": "**汇总**：{ok_count}/{total} 项正常",
    "summary_partial": "**汇总**：{ok_count}/{total} 项正常，{fail_count} 项异常",
    "separator": "---",
    "footer": "###### ※ 小秘书提醒"
  },

  "doc_review": {
    "_note": "预审推送文案（正文可保留 PM助理 人设）；钉钉机器人关键词须为「小秘书提醒」，与 webhook title/footer 一致。强制重跑口令：再预审、强制预审、预审再来、预审重试、坚持预审等（见 skill_router _precheck_command_flags）",
    "keyword": "小秘书提醒",
    "started": "PM助理 收到文档链接，正在读取并预审，请稍候（约 1-2 分钟）...",
    "progress_update": "PM助理 **预审进行中**\n- **阶段**：{phase}\n- **已等待**：约 {elapsed} 秒\n- **文档**：{doc_title}\n\n多角色预审可能需数分钟，无需重复发送指令。",
    "fetch_fail": "PM助理 文档读取失败: {error}",
    "content_too_short": "PM助理 文档《{title}》内容过少（{length} 字），可能页面未完全渲染。\n{url}",
    "palace_fail": "PM助理 文档预审引擎异常: {error}\n文档: {title}\n{url}",
    "no_link": "PM助理 收到预审指令，但未找到最近的文档链接。请先发送文档链接，再发送「预审」。",
    "recently_attempted": "PM助理 该文档在近期已尝试过预审（含失败也会记入），请 {minutes} 分钟后再试，或发「再预审」「强制预审」「预审再来」立即重跑。",
    "summary_header": "### PM助理 · 文档预审完成",
    "summary_doc": "**《{title}》**",
    "summary_verdict": "**结论** {verdict_badge} **{verdict_label}**",
    "summary_stats_prefix": "**问题清单**",
    "summary_stat_p0": "🔴 P0 **{count}** 项",
    "summary_stat_p1": "🟡 P1 **{count}** 项",
    "summary_no_issues": "**问题清单**：未返回 P0/P1 分项，请打开完整报告查看。",
    "summary_separator_major": "---",
    "summary_section_p0": "#### 🔴 P0 阻断（共 {count} 项）",
    "summary_section_p1": "#### 🟡 P1 关注（共 {count} 项）",
    "summary_more_p0": "… 共 **{total}** 项，此处仅列前 **{shown}** 项，其余见 Palace 报告。",
    "summary_more_p1": "… 共 **{total}** 项，此处仅列前 **{shown}** 项，其余见 Palace 报告。",
    "summary_p0_fallback": "🔴 引擎汇总 P0 **{count}** 项（明细未在推送中展开，请打开完整报告）。",
    "summary_p1_fallback": "🟡 引擎汇总 P1 **{count}** 项（明细未在推送中展开，请打开完整报告）。",
    "summary_max_issues_per_severity": 6,
    "summary_max_gap_chars": 100,
    "summary_chars": "**提取字数** {text_length}",
    "summary_report": "**完整报告** [{report_link_label}]({report_url})",
    "summary_original": "**原文** [打开钉钉文档]({url})",
    "separator": "---",
    "footer": "###### ※ 小秘书提醒·文档预审"
  }
}
